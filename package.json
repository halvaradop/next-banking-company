{
  "name": "next-banking-company",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "15.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@halvaradop/tailwindcss-utilities": "^1.0.0",
    "@tailwindcss/postcss": "^4.1.6",
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.6",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.12.0",
  "prettier": {
    "semi": false,
    "printWidth": 130,
    "tabWidth": 4,
    "overrides": [
      {
        "files": [
          "*.json",
